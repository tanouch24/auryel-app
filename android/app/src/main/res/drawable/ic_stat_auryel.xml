<?xml version="1.0" encoding="utf-8"?>
<!-- Petite icône de notification Auryel (status bar Android).
     Silhouette monochrome BLANCHE sur fond TRANSPARENT : le système applique
     lui-même la teinte et le fond. Forme : le "A" Auryel (triangle plein avec
     contre-forme évidée = barre transversale), bold pour rester lisible à 24 dp.
     N'affecte PAS l'icône du launcher (@mipmap/ic_launcher). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2.6 L21,20.4 L3,20.4 Z M12,11.5 L15.8,16.5 L8.2,16.5 Z" />
</vector>
