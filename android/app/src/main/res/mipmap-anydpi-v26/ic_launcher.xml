<?xml version="1.0" encoding="utf-8"?>
<!-- Icône adaptative Auryel (API 26+). Le masque (circle / squircle /
     rounded-square) et la parallaxe sont appliqués par Android : le symbole
     (A doré + étoile + orbite) tient dans la zone de sécurité (72/108) et
     n'est jamais coupé. Le fond est un dégradé nébuleux sans symbole. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
