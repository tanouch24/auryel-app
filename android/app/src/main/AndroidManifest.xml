<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Requis pour les appels à l'API Auryel (auth OTP, consultations). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ (targetSdk 36) : autorisation d'affichage des notifications.
         Demandée UNIQUEMENT à l'exécution, via le CTA explicite de
         NotificationSettingsScreen — jamais automatiquement au démarrage.
         com.android.vending.BILLING est ajoutée par la Billing Library ;
         le service FirebaseMessagingService est fusionné par le plugin
         firebase_messaging. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- RÉVEIL AURYEL — alarme exacte. SCHEDULE_EXACT_ALARM (PAS
         USE_EXACT_ALARM : Auryel n'est pas une appli dédiée alarme/minuteur,
         cf. politique Play). Vérifiée via canScheduleExactAlarms() avant toute
         programmation ; si refusée, l'utilisateur est guidé vers le réglage
         spécial "Alarmes et rappels" (ACTION_REQUEST_SCHEDULE_EXACT_ALARM),
         jamais une exigence bloquante au démarrage. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Écran d'alarme affiché même verrouillé (notification plein écran +
         activité). Permission NORMALE (accordée à l'installation) jusqu'à
         Android 13 ; à partir d'Android 14, vérifiée à l'exécution via
         NotificationManagerCompat.canUseFullScreenIntent() côté natif — repli
         sur une notification haute priorité classique si refusée. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- Reprogrammer l'alarme après un redémarrage du téléphone (les alarmes
         AlarmManager ne survivent PAS un reboot par elles-mêmes). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Bref réveil CPU le temps que l'écran d'alarme s'affiche réellement. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <application
        android:label="Auryel"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false">
        <!-- allowBackup=false : l'app contient session, profil, consultations et
             achats. La restauration de compte est côté serveur (email/OTP + IAP
             restore), pas via Android Backup. Les clés de flutter_secure_storage
             vivent dans l'AndroidKeystore (jamais sauvegardées) : sauvegarder le
             blob chiffré sans ses clés le rendrait illisible au restore. Aucune
             fonctionnalité ne dépend d'Android Auto Backup. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- RÉVEIL AURYEL — reçoit le déclenchement AlarmManager exact
             (setExactAndAllowWhileIdle). Jamais exportée : seule l'app
             s'auto-programme, aucun autre appelant système direct. -->
        <receiver
            android:name=".WakeAlarmReceiver"
            android:exported="false" />
        <!-- Reprogramme l'alarme après reboot (AlarmManager ne survit pas un
             redémarrage). Lit un fichier SharedPreferences NATIF dédié
             ("auryel_wake_alarm", écrit uniquement par AlarmScheduler.kt,
             DISTINCT de "FlutterSharedPreferences") : reprogrammation sans
             dépendre d'un moteur Flutter complet à ce stade. -->
        <receiver
            android:name=".WakeBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- FCM : canal Android utilisé quand un message `notification` arrive
             app en arrière-plan / tuée. Le canal `auryel_default_v2` est créé côté
             Dart (flutter_local_notifications) avec visibilité PRIVATE (rien de
             sensible sur écran verrouillé). -->
        <meta-data
          android:name="com.google.firebase.messaging.default_notification_channel_id"
          android:value="auryel_default_v2" />
        <!-- Petite icône status bar : silhouette monochrome dédiée (jamais
             l'icône launcher couleur, illisible en barre d'état). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_auryel" />

        <!-- Meta App Events (mesure publicitaire, sous consentement explicite).
             Valeurs NON versionnées : injectées par manifestPlaceholders depuis
             android/meta.properties (gitignore). Auto-logging et collecte de
             l'identifiant publicitaire DÉSACTIVÉS par défaut ; activés seulement
             après consentement, côté Dart. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="${metaAppId}" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="${metaClientToken}" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${adMobAppId}" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
